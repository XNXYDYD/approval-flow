{
  "name": "overtime-application",
  "version": "1.0.0",
  "description": "加班申请管理系统",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint \"src/**/*.{js,ts,svelte}\" --max-warnings 999",
    "lint:fix": "eslint \"src/**/*.{js,ts,svelte}\" --fix --max-warnings 999",
    "lint:strict": "eslint \"src/**/*.{js,ts,svelte}\"",
    "format": "prettier --write \"src/**/*.{js,ts,svelte,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,svelte,css,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@sveltejs/adapter-auto": "^3.2.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/svelte": "^4.1.0",
    "@types/node": "^20.12.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^1.5.0",
    "autoprefixer": "^10.4.19",
    "bits-ui": "^0.22.0",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.5.2",
    "lucide-svelte": "^1.0.1",
    "postcss": "^8.4.38",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^4.2.12",
    "svelte-check": "^3.6.0",
    "svelte-eslint-parser": "^1.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^3.4.3",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "date-fns": "^4.4.0",
    "date-picker-svelte": "^2.17.0",
    "echarts": "^5.5.0",
    "to-regex-range": "^5.0.1"
  }
}
